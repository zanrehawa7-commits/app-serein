# Stage Track — Variables d'environnement
# Copier ce fichier : cp .env.example .env
# Le .env doit rester a la RACINE du projet (app-serein/), jamais commite.
# python-decouple le lit depuis backend/ en remontant dans les dossiers parents.

# --- Securite ---
DEBUG=True
# Generer avec : python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=remplacer-par-une-cle-secrete-generee-avec-secrets.token_urlsafe

ALLOWED_HOSTS=localhost,127.0.0.1

# --- Base de donnees PostgreSQL ---
# Local : DB_HOST=localhost
# Docker Compose : DB_HOST=db
DB_NAME=serein_db
DB_USER=serein_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- CORS / CSRF ---
# En production : remplacer par le domaine reel (ex. https://serein.example.com)
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
